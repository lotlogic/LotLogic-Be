doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title LotCheck Lead Notification
    style.
      body {
        margin: 0;
        padding: 24px;
        background: #f5f4f2;
        font-family: Montserrat, Arial, sans-serif;
        color: #2b3d48;
      }

      .shell {
        max-width: 620px;
        margin: 0 auto;
      }

      .card {
        background: #ffffff;
        border: 1px solid #d0cfc9;
        border-radius: 8px;
        overflow: hidden;
      }

      .header {
        background: #2b3d48;
        padding: 20px 28px;
      }

      .logo {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 0.2px;
        color: #ffffff;
      }

      .logo-lot {
        color: #ef7b6c;
      }

      .accent {
        height: 4px;
        background: #ef7b6c;
      }

      .content {
        padding: 32px 28px;
        line-height: 1.65;
      }

      .content p {
        margin: 0 0 14px 0;
        font-size: 14px;
      }

      .greeting {
        font-size: 16px;
        font-weight: 600;
      }

      .lead-note {
        margin: 0 0 14px 0;
        padding: 10px 12px;
        border-radius: 6px;
        background: #fff2f0;
        border: 1px solid #ef7b6c;
        color: #8f3f34;
        font-weight: 700;
      }

      .details {
        margin: 0 0 14px 0;
        padding: 14px 16px;
        border-radius: 6px;
        background: #f5f4f2;
        border: 1px solid #e8e7e5;
      }

      .details p {
        margin: 0 0 8px 0;
      }

      .details p:last-child {
        margin-bottom: 0;
      }

      .label {
        font-weight: 700;
      }

      .footer {
        background: #2b3d48;
        border-top: 1px solid #d0cfc9;
        padding: 16px 28px;
      }

      .footer p {
        margin: 0;
        color: rgba(255, 255, 255, 0.78);
        font-size: 12px;
      }
  body
    .shell
      .card
        .header
          p.logo
            span.logo-lot lot
            | check.
        .accent
        .content
          p.greeting Hi #{builderName},

          p A buyer has requested detailed pricing for one of your designs on a LotCheck block.

          .details
            p
              span.label Buyer:
              |  #{buyerName}
            p
              span.label Email:
              |  #{buyerEmail}
            p
              span.label Phone:
              |  #{buyerPhone}
            p
              span.label Design:
              |  #{designName}
            p
              span.label Facade:
              |  #{selectedFacade}
            p
              span.label Finishes:
              |  #{finishesLevel}
            p
              span.label Block secured:
              |  #{blockSecuredLabel}

          .details
            p
              span.label Lot Number:
              |  #{lotNumber}
            p
              span.label Address:
              |  #{lotAddress}
            p
              span.label Lot Size:
              |  #{lotSize} m2
            p
              span.label Zoning:
              |  #{lotZoning}
            p
              span.label Status:
              |  #{lotStatus}
            p
              span.label Notes:
              |  #{comments || 'Not provided'}

          p If you need anything from our team, reply to this email and we will assist.
          p
            strong The LotCheck Team
        .footer
          p This is an automated LotCheck message.
