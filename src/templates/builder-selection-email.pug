doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title LotCheck Lead Notification
    style.
      body {
        margin: 0;
        padding: 24px;
        background: #f5f4f2;
        font-family: Montserrat, Arial, sans-serif;
        color: #2b3d48;
      }

      .shell {
        max-width: 620px;
        margin: 0 auto;
      }

      .card {
        background: #ffffff;
        border: 1px solid #d0cfc9;
        border-radius: 8px;
        overflow: hidden;
      }

      .header {
        background: #2b3d48;
        padding: 20px 28px;
      }

      .logo {
        margin: 0;
        font-size: 22px;
        font-weight: 700;
        color: #ffffff;
      }

      .accent {
        height: 4px;
        background: #ef7b6c;
      }

      .content {
        padding: 28px;
        line-height: 1.65;
      }

      .content p {
        margin: 0 0 14px 0;
        font-size: 14px;
      }

      .lead-note {
        margin: 0 0 14px 0;
        padding: 10px 12px;
        border-radius: 6px;
        background: #fff2f0;
        border: 1px solid #ef7b6c;
        color: #8f3f34;
        font-weight: 700;
      }

      .details {
        margin: 0 0 14px 0;
        padding: 14px 16px;
        border-radius: 6px;
        background: #f5f4f2;
        border: 1px solid #e8e7e5;
      }

      .details p {
        margin: 0 0 8px 0;
      }

      .details p:last-child {
        margin-bottom: 0;
      }

      .label {
        font-weight: 700;
      }

      .footer {
        background: #2b3d48;
        padding: 16px 28px;
      }

      .footer p {
        margin: 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 12px;
      }
  body
    .shell
      .card
        .header
          p.logo lotcheck.
        .accent
        .content
          p Hi #{builderName},

          if hotLead
            p.lead-note HOT LEAD: buyer is highly interested and may act quickly.

          if isSelected
            p Great news - you have been selected to proceed for this lot enquiry.
          else
            p A buyer has requested building information and your plans have been selected for consideration.

          .details
            p
              span.label Lot Number:
              |  #{lotNumber}
            p
              span.label Address:
              |  #{lotAddress}
            p
              span.label Lot Size:
              |  #{lotSize} m2
            p
              span.label Zoning:
              |  #{lotZoning}
            p
              span.label Status:
              |  #{lotStatus}
            p
              span.label Notes:
              |  #{comments || 'Not provided'}

          p If you need anything from our team, reply to this email and we will assist.
          p
            strong The LotCheck Team
        .footer
          p This is an automated LotCheck message.
