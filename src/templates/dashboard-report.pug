doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= report.cover.title || 'BlockPlanner Report'
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap')
    style.
      :root {
        --eucalypt: #6d7a70;
        --sand: #f8f6e4;
        --sand-dark: #e7e1d0;
        --bluegum: #494f4a;
        --white: #ffffff;
        --ink: #2a2f2b;
        --muted: #6f736d;
        --page-bg: #e2dfd2;
        --border: #d9d3c6;
        --green-bg: #edf4ee;
        --green-fg: #46684b;
        --amber-bg: #f4ead8;
        --amber-fg: #8a6427;
        --grey-bg: #efefec;
        --grey-fg: #73736d;
      }

      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--white);
        font-family: 'Lexend', 'Segoe UI', sans-serif;
        color: var(--ink);
        font-size: 11pt;
        line-height: 1.6;
      }

      p, li, h1, h2, h3 { margin: 0; }
      img { display: block; max-width: 100%; }
      .page { max-width: 820px; margin: 0 auto; }
      .report {
        background: var(--white);
        box-shadow: 0 10px 34px rgba(0, 0, 0, 0.08);
      }

      .report-header {
        background: var(--bluegum);
        padding: 22px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo-lockup {
        display: flex;
        align-items: center;
        gap: 11px;
      }

      .logo-wordmark {
        font-size: 16px;
        font-weight: 600;
        color: var(--sand);
      }

      .logo-wordmark span { font-weight: 300; }

      .report-type {
        font-size: 9.5px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(248, 246, 228, 0.55);
      }

      .property-band {
        background: var(--sand);
        padding: 24px 40px 22px;
        border-bottom: 1px solid var(--border);
      }

      .property-address {
        font-size: 20px;
        font-weight: 600;
        color: var(--bluegum);
        line-height: 1.25;
        margin-bottom: 10px;
      }

      .property-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
      }

      .chip {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 5px 11px;
        border-radius: 20px;
      }

      .chip-zone {
        background: var(--eucalypt);
        color: var(--sand);
      }

      .chip-meta {
        border: 1px solid var(--border);
        color: var(--muted);
      }

      .property-note {
        font-size: 10px;
        color: var(--muted);
      }

      .report-body {
        padding: 30px 40px 36px;
      }

      .section-header {
        padding: 0 0 14px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .section-title {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--eucalypt);
      }

      .section-rule {
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .exec-intro {
        background: #faf8f1;
        border-left: 3px solid var(--eucalypt);
        padding: 18px 20px;
        margin-bottom: 18px;
        color: #525751;
      }

      .subsection-title {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--eucalypt);
        margin-bottom: 8px;
      }

      .summary-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 8px;
        border: 1px solid var(--border);
        overflow: hidden;
      }

      .summary-table thead tr {
        background: var(--bluegum);
      }

      .summary-table thead th {
        padding: 11px 14px;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(248, 246, 228, 0.8);
        text-align: left;
      }

      .summary-table tbody tr {
        border-bottom: 1px solid var(--sand-dark);
      }

      .summary-table tbody tr:last-child {
        border-bottom: none;
      }

      .summary-table td {
        padding: 14px;
        vertical-align: top;
      }

      .option-title {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--bluegum);
        margin-bottom: 3px;
      }

      .option-subtitle {
        font-size: 10px;
        color: var(--muted);
      }

      .summary-copy {
        color: #565a56;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
      }

      .status-pill.possible {
        background: var(--green-bg);
        color: var(--green-fg);
      }

      .status-pill.review {
        background: var(--amber-bg);
        color: var(--amber-fg);
      }

      .status-pill.not_available {
        background: var(--grey-bg);
        color: var(--grey-fg);
      }

      .summary-note {
        font-size: 10px;
        color: var(--muted);
        font-style: italic;
        margin-bottom: 18px;
      }

      .overall-view {
        background: var(--bluegum);
        color: var(--sand);
        padding: 18px 20px;
        margin-top: 14px;
        break-inside: avoid;
      }

      .overall-view-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(248, 246, 228, 0.55);
        margin-bottom: 8px;
      }

      .site-intro {
        color: var(--muted);
        margin-bottom: 18px;
      }

      .site-map-card,
      .site-card {
        border: 1px solid var(--border);
        margin-bottom: 16px;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .card-header {
        padding: 14px 18px;
        background: #f5f2e8;
        border-bottom: 1px solid var(--border);
      }

      .card-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--bluegum);
      }

      .card-body {
        padding: 18px;
      }

      .site-map-image {
        width: 100%;
        max-height: 280px;
        object-fit: cover;
        border: 1px solid var(--border);
      }

      .site-map-caption {
        margin-top: 10px;
        font-size: 9px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .meta-items {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 12px;
      }

      .meta-item {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 5px 10px;
      }

      .meta-item strong {
        color: var(--bluegum);
      }

      .site-card p + p {
        margin-top: 8px;
      }

      .site-card ul {
        margin: 10px 0 0 0;
        padding-left: 18px;
      }

      .site-card li + li {
        margin-top: 5px;
      }

      .next-step {
        break-before: page;
        page-break-before: always;
        padding: 34px 40px 24px;
      }

      .next-step-card {
        background: var(--sand);
        border: 1px solid var(--border);
        padding: 22px 24px;
      }

      .intention-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--eucalypt);
        margin-bottom: 10px;
      }

      .next-step-card h2 {
        font-size: 20px;
        color: var(--bluegum);
        margin-bottom: 14px;
      }

      .next-step-card p + p {
        margin-top: 10px;
      }

      .checklist {
        list-style: none;
        padding: 0;
        margin: 16px 0;
      }

      .checklist li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
      }

      .checklist li + li {
        margin-top: 9px;
      }

      .checkbox {
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--eucalypt);
        margin-top: 3px;
        flex: 0 0 14px;
      }

      .cta-chip {
        display: inline-block;
        margin-top: 16px;
        padding: 10px 16px;
        text-decoration: none;
        background: var(--bluegum);
        color: var(--sand);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .contact-panel,
      .disclaimer,
      .report-footer {
        padding: 0 40px 28px;
      }

      .contact-panel h3,
      .disclaimer h3 {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--eucalypt);
        margin-bottom: 12px;
      }

      .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
      }

      .contact-link {
        color: var(--bluegum);
        text-decoration: none;
        border: 1px solid var(--border);
        padding: 7px 10px;
        font-size: 10px;
      }

      .disclaimer p + p {
        margin-top: 8px;
      }

      .report-footer {
        font-size: 9px;
        color: var(--muted);
        padding-bottom: 32px;
      }

      @page {
        size: A4;
        margin: 14mm 12mm 16mm;
      }
  body
    .page
      .report
        .report-header
          .logo-lockup
            .logo-mark
              svg(width='28' height='28' viewBox='0 0 28 28' fill='none' xmlns='http://www.w3.org/2000/svg')
                path(d='M6 4H16C19.3137 4 22 6.68629 22 10C22 11.6569 21.3284 13.1569 20.2426 14.2426C21.3284 15.3284 22 16.8284 22 18.5C22 21.8137 19.3137 24.5 16 24.5H6V4Z' stroke='#F8F6E4' stroke-width='1.4' fill='none')
                path(d='M6 4L10 7.5V21L6 24.5' stroke='#F8F6E4' stroke-width='1.4' stroke-linecap='round')
                path(d='M6 14.5H16C17.933 14.5 19.5 13.0449 19.5 11.25C19.5 9.45507 17.933 8 16 8H6' stroke='#F8F6E4' stroke-width='1.4')
            span.logo-wordmark
              strong Block
              span Planner
          span.report-type Property Assessment

        .property-band
          .property-address= report.cover.address
          .property-chips
            span.chip.chip-zone= report.property.zone
            if report.property.blockSize && report.property.blockSize !== '—'
              span.chip.chip-meta= report.property.blockSize
            if report.property.frontage && report.property.frontage !== '—'
              span.chip.chip-meta Frontage #{report.property.frontage}
            if report.cover.blockSection
              span.chip.chip-meta= report.cover.blockSection
            span.chip.chip-meta= report.cover.date
            if report.cover.reportId
              span.chip.chip-meta Report #{report.cover.reportId}
          p.property-note
            strong Prepared for:
            |  #{report.cover.preparedFor}
            |  · Intention: #{report.property.intention}
            |  · #{report.property.note}

        .report-body
          .section-header
            span.section-title= report.executiveSummary.title
            .section-rule
          p.exec-intro= report.executiveSummary.intro

          .subsection-title= report.executiveSummary.rulesTitle
          table.summary-table
            thead
              tr
                th(style='width:34%') Option
                th(style='width:46%') Planning position
                th(style='width:20%') Size threshold
            tbody
              each item in report.executiveSummary.rulesRows
                tr
                  td
                    .option-title= item.title
                    if item.subtitle
                      .option-subtitle= item.subtitle
                  td.summary-copy= item.text
                  td
                    span.status-pill(class=item.statusTone)= item.statusLabel
          p.summary-note= report.executiveSummary.rulesNote

          .subsection-title= report.executiveSummary.findingsTitle
          table.summary-table
            thead
              tr
                th(style='width:30%') Option
                th(style='width:50%') What we found on this block
                th(style='width:20%') Our read
            tbody
              each item in report.executiveSummary.findingsRows
                tr
                  td
                    .option-title= item.title
                    if item.subtitle
                      .option-subtitle= item.subtitle
                  td.summary-copy= item.text
                  td
                    span.status-pill(class=item.statusTone)= item.statusLabel

          if report.executiveSummary.summary
            .overall-view
              .overall-view-label Overall view
              p= report.executiveSummary.summary

          .section-header(style='margin-top: 30px;')
            span.section-title Site assessment
            .section-rule
          p.site-intro
            | This section looks at the physical conditions on your block. These are the practical constraints that determine whether the options above are likely to work in the real world.

          if report.siteMap
            .site-map-card
              .card-header
                .card-title Site map
              .card-body
                img.site-map-image(src=report.siteMap.url alt=report.siteMap.label)
                .site-map-caption
                  span= report.siteMap.label
                  |  · #{report.siteMap.note}

          each section in report.siteSections
            .site-card
              .card-header
                .card-title= section.title
              .card-body
                if section.metaItems && section.metaItems.length
                  .meta-items
                    each item in section.metaItems
                      span.meta-item
                        strong #{item.label}:
                        |  #{item.value}
                each para in section.paragraphs
                  p= para
                if section.bullets && section.bullets.length
                  ul
                    each item in section.bullets
                      li= item

        .next-step
          .next-step-card
            .intention-label Intention: #{report.nextStep.intentionLabel}
            h2= report.nextStep.title
            each para in report.nextStep.paragraphs
              p= para
            ul.checklist
              each item in report.nextStep.checklist
                li
                  span.checkbox
                  span= item
            p= report.nextStep.closing
            a.cta-chip(href=`mailto:${report.contact.email}`)= report.nextStep.cta

        .contact-panel
          h3 Want to take this further?
          p
            strong= report.contact.name
            |  · #{report.contact.role}
          p BlockPlanner can help with feasibility analysis, planning advice and the right introductions for the next stage of the project.
          .contact-links
            a.contact-link(href=`mailto:${report.contact.email}`)= report.contact.email
            if report.contact.phone
              span.contact-link= report.contact.phone
            a.contact-link(href=report.contact.websiteUrl)= report.contact.websiteLabel
            if report.contact.linkedinUrl
              a.contact-link(href=report.contact.linkedinUrl) LinkedIn

        .disclaimer
          h3 Important disclaimer
          each para in report.disclaimer.paragraphs
            p= para

        .report-footer
          p BlockPlanner Property Assessment Report
