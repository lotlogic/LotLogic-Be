doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= report.cover.title || 'BlockPlanner Report'
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap')
    style.
      :root {
        --eucalypt: #6d7a70;
        --sand: #f8f6e4;
        --bluegum: #494f4a;
        --white: #ffffff;
        --ink: #2a2f2b;
        --muted: #6f736d;
        --page-bg: #e2dfd2;
        --rule: #dedad0;
        --rule-light: #ece9df;
        --possible-bg: #edf2ee;
        --possible-fg: #3a6644;
        --possible-border: rgba(58, 102, 68, 0.18);
        --review-bg: #f6efe0;
        --review-fg: #8a6427;
        --review-border: rgba(138, 100, 39, 0.18);
        --unavail-bg: #f4f3ef;
        --unavail-fg: #7a7d78;
        --unavail-border: rgba(100, 100, 95, 0.18);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--white);
        font-family: 'Lexend', 'Segoe UI', sans-serif;
        color: var(--ink);
        font-size: 11pt;
        line-height: 1.55;
        padding: 0;
      }

      p, li { margin: 0; }
      h1, h2, h3 { margin: 0; break-after: avoid; }
      img { display: block; max-width: 100%; }

      .page {
        max-width: 820px;
        margin: 0 auto;
      }

      .report {
        background: var(--white);
        border-radius: 3px;
        overflow: hidden;
        box-shadow:
          -6px 0 18px rgba(0, 0, 0, 0.07),
          -2px 0 6px rgba(0, 0, 0, 0.05),
          2px 4px 12px rgba(0, 0, 0, 0.06),
          0 12px 40px rgba(0, 0, 0, 0.09),
          0 1px 0 rgba(0, 0, 0, 0.04);
      }

      .report-header {
        background: var(--bluegum);
        padding: 22px 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo-lockup {
        display: flex;
        align-items: center;
        gap: 11px;
      }

      .logo-wordmark {
        font-size: 16px;
        font-weight: 600;
        color: var(--sand);
        letter-spacing: 0.01em;
      }

      .logo-wordmark span { font-weight: 300; }

      .report-type {
        font-size: 9.5px;
        font-weight: 400;
        color: rgba(248, 246, 228, 0.5);
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .property-band {
        background: var(--sand);
        padding: 24px 40px 22px;
        border-bottom: 1px solid var(--rule);
      }

      .property-address {
        font-size: 20px;
        font-weight: 600;
        color: var(--bluegum);
        line-height: 1.25;
        margin-bottom: 10px;
      }

      .property-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
      }

      .chip {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 5px 11px;
        border-radius: 20px;
      }

      .chip-zone {
        background: var(--eucalypt);
        color: var(--sand);
      }

      .chip-meta {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--rule);
        letter-spacing: 0.04em;
      }

      .property-note {
        font-size: 10px;
        color: var(--muted);
      }

      .image-panel {
        border-bottom: 1px solid var(--rule);
        background: #d8d5c8;
      }

      .image-panel img {
        width: 100%;
        max-height: 270px;
        object-fit: cover;
      }

      .image-caption {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 16px;
        background: #f5f2e8;
        font-size: 9px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .report-body {
        padding: 30px 40px 36px;
      }

      .section-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--eucalypt);
        padding-bottom: 10px;
        border-bottom: 1px solid var(--rule);
        margin-bottom: 16px;
      }

      .lead {
        color: #555a56;
        margin-bottom: 18px;
      }

      .summary-table {
        width: 100%;
        border-collapse: collapse;
        border: 1px solid var(--rule);
        margin-bottom: 18px;
      }

      .summary-table th,
      .summary-table td {
        border-bottom: 1px solid var(--rule-light);
        padding: 14px 16px;
        vertical-align: top;
        text-align: left;
      }

      .summary-table th {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        background: #faf8f1;
      }

      .summary-table tr:last-child td {
        border-bottom: none;
      }

      .summary-title {
        font-size: 12.5px;
        font-weight: 600;
        color: var(--bluegum);
      }

      .summary-text {
        color: #585c58;
        font-size: 10.5pt;
      }

      .status-cell {
        width: 120px;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        font-size: 10px;
        font-weight: 600;
        padding: 5px 11px;
        border-radius: 20px;
        letter-spacing: 0.05em;
        white-space: nowrap;
      }

      .status-pill.possible {
        background: var(--possible-bg);
        color: var(--possible-fg);
        border: 1px solid var(--possible-border);
      }

      .status-pill.review {
        background: var(--review-bg);
        color: var(--review-fg);
        border: 1px solid var(--review-border);
      }

      .status-pill.not_available {
        background: var(--unavail-bg);
        color: var(--unavail-fg);
        border: 1px solid var(--unavail-border);
      }

      .summary-note {
        background: var(--sand);
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 16px 18px;
        break-inside: avoid;
      }

      .summary-note strong {
        display: block;
        color: var(--bluegum);
        margin-bottom: 6px;
      }

      .site-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .site-card {
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 18px 18px 16px;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .site-card h3 {
        font-size: 13px;
        color: var(--bluegum);
        margin-bottom: 10px;
      }

      .meta-items {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 10px;
      }

      .meta-item {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        border: 1px solid var(--rule);
        border-radius: 20px;
        padding: 5px 10px;
      }

      .meta-item strong {
        color: var(--bluegum);
      }

      .site-card p + p {
        margin-top: 8px;
      }

      .site-card ul {
        margin: 10px 0 0 0;
        padding-left: 18px;
      }

      .site-card li + li {
        margin-top: 5px;
      }

      .next-step {
        break-before: page;
        page-break-before: always;
        padding: 34px 40px 24px;
      }

      .next-step-card {
        background: var(--sand);
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 22px 24px;
      }

      .intention-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--eucalypt);
        margin-bottom: 10px;
      }

      .next-step-card h2 {
        font-size: 20px;
        color: var(--bluegum);
        margin-bottom: 14px;
      }

      .next-step-card p + p {
        margin-top: 10px;
      }

      .checklist {
        list-style: none;
        padding: 0;
        margin: 16px 0;
      }

      .checklist li {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 8px 0;
        border-top: 1px solid rgba(109, 122, 112, 0.14);
      }

      .checklist li:first-child {
        border-top: none;
        padding-top: 0;
      }

      .checkbox {
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--eucalypt);
        border-radius: 2px;
        margin-top: 3px;
        flex: 0 0 14px;
      }

      .cta-chip {
        display: inline-block;
        margin-top: 16px;
        background: var(--bluegum);
        color: var(--sand);
        padding: 10px 16px;
        border-radius: 3px;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
      }

      .contact-panel,
      .disclaimer {
        margin: 18px 40px 0;
        border: 1px solid var(--rule);
        border-radius: 3px;
        padding: 18px 20px;
        break-inside: avoid;
      }

      .contact-panel {
        background: #fbfaf5;
      }

      .contact-panel h3,
      .disclaimer h3 {
        font-size: 13px;
        color: var(--bluegum);
        margin-bottom: 8px;
      }

      .contact-links {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 12px;
      }

      .contact-link {
        display: inline-block;
        color: var(--eucalypt);
        text-decoration: none;
        border: 1px solid var(--rule);
        border-radius: 20px;
        padding: 6px 10px;
        font-size: 9px;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      }

      .disclaimer {
        background: #f9f8f3;
      }

      .disclaimer p + p {
        margin-top: 8px;
      }

      .report-footer {
        margin-top: 22px;
        border-top: 1px solid var(--rule);
        background: var(--white);
        padding: 18px 40px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        font-size: 10px;
        color: var(--muted);
      }

      .report-footer strong {
        color: var(--bluegum);
      }

      @page {
        size: A4;
        margin: 14mm 12mm 16mm;
      }
  body
    - const statusLabels = { possible: 'Possible', review: 'Needs review', not_available: 'Not available' };
    .page
      .report
        .report-header
          .logo-lockup
            .logo-mark
              svg(width='28' height='28' viewBox='0 0 28 28' fill='none' xmlns='http://www.w3.org/2000/svg')
                path(d='M6 4H16C19.3137 4 22 6.68629 22 10C22 11.6569 21.3284 13.1569 20.2426 14.2426C21.3284 15.3284 22 16.8284 22 18.5C22 21.8137 19.3137 24.5 16 24.5H6V4Z' stroke='#F8F6E4' stroke-width='1.4' fill='none')
                path(d='M6 4L10 7.5V21L6 24.5' stroke='#F8F6E4' stroke-width='1.4' stroke-linecap='round')
                path(d='M6 14.5H16C17.933 14.5 19.5 13.0449 19.5 11.25C19.5 9.45507 17.933 8 16 8H6' stroke='#F8F6E4' stroke-width='1.4')
            span.logo-wordmark
              strong Block
              span Planner
          span.report-type Property Assessment

        .property-band
          .property-address= report.cover.address
          .property-chips
            span.chip.chip-zone= report.property.zone
            if report.property.blockSize && report.property.blockSize !== '—'
              span.chip.chip-meta= report.property.blockSize
            if report.property.frontage && report.property.frontage !== '—'
              span.chip.chip-meta Frontage #{report.property.frontage}
            if report.cover.blockSection
              span.chip.chip-meta= report.cover.blockSection
            span.chip.chip-meta= report.cover.date
            if report.cover.reportId
              span.chip.chip-meta Report #{report.cover.reportId}
          p.property-note
            strong Prepared for:
            |  #{report.cover.preparedFor}
            |  · Intention: #{report.property.intention}
            |  · #{report.property.note}

        if report.imagery
          .image-panel
            img(src=report.imagery.url alt=report.imagery.label)
            .image-caption
              span= report.imagery.label
              span= report.imagery.note

        .report-body
          .section-label= report.executiveSummary.title
          p.lead= report.executiveSummary.intro

          table.summary-table
            thead
              tr
                th Option
                th What it means
                th.status-cell Status
            tbody
              each item in report.executiveSummary.bullets
                tr
                  td
                    .summary-title= item.title
                  td.summary-text= item.text
                  td.status-cell
                    span.status-pill(class=item.status)= statusLabels[item.status]

          if report.executiveSummary.summary
            .summary-note
              strong Overall view
              p= report.executiveSummary.summary

          .section-label(style='margin-top: 28px;') Site assessment
          .site-grid
            each section in report.siteSections
              .site-card
                h3= section.title
                if section.metaItems && section.metaItems.length
                  .meta-items
                    each item in section.metaItems
                      span.meta-item
                        strong #{item.label}:
                        |  #{item.value}
                each para in section.paragraphs
                  p= para
                if section.bullets && section.bullets.length
                  ul
                    each item in section.bullets
                      li= item

        .next-step
          .next-step-card
            .intention-label Intention: #{report.nextStep.intentionLabel}
            h2= report.nextStep.title
            each para in report.nextStep.paragraphs
              p= para
            ul.checklist
              each item in report.nextStep.checklist
                li
                  span.checkbox
                  span= item
            p= report.nextStep.closing
            a.cta-chip(href=`mailto:${report.contact.email}`)= report.nextStep.cta

        .contact-panel
          h3 Want to take this further?
          p
            strong= report.contact.name
            |  · #{report.contact.role}
          p BlockPlanner can help with feasibility analysis, planning advice and the right introductions for the next stage of the project.
          .contact-links
            a.contact-link(href=`mailto:${report.contact.email}`)= report.contact.email
            if report.contact.phone
              span.contact-link= report.contact.phone
            a.contact-link(href=report.contact.websiteUrl)= report.contact.websiteLabel
            if report.contact.linkedinUrl
              a.contact-link(href=report.contact.linkedinUrl) LinkedIn

        .disclaimer
          h3 Important disclaimer
          each para in report.disclaimer.paragraphs
            p= para

        .report-footer
          span
            strong= report.contact.websiteLabel
          span Prepared for #{report.cover.preparedFor}
