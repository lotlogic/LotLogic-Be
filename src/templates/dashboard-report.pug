doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title= report.cover.title || 'BlockPlanner Report'
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap')
    style.
      :root {
        --sand: #f8f6e4;
        --eucalypt: #6d7a70;
        --bluegum: #494f4a;
        --sand-dark: #ede9cc;
        --sand-mid: #f2efd8;
        --text: #2a2d2b;
        --text-light: #5a6060;
        --border: #d8d4be;
        --white: #ffffff;
        --green-ok: #3a6b4a;
        --green-ok-bg: #eaf2ec;
        --amber: #8b6914;
        --amber-bg: #fdf4dc;
        --red: #7a3030;
        --red-bg: #f5eaea;
        --grey: #6a6a6a;
        --grey-bg: #f0f0f0;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Lexend', sans-serif;
        background: #e8e4d0;
        color: var(--text);
        font-size: 14px;
        line-height: 1.6;
      }

      a {
        color: inherit;
      }

      .page {
        max-width: 860px;
        margin: 0 auto;
        background: var(--sand);
      }

      .cover {
        position: relative;
        height: 340px;
        overflow: hidden;
      }

      .cover-photo {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: brightness(0.72);
      }

      .cover-photo-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(160deg, #3d5a45 0%, #2a3d30 40%, #1e2e24 100%);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .aerial-placeholder {
        width: 100%;
        height: 100%;
        background:
          repeating-linear-gradient(0deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 40px),
          repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 40px),
          linear-gradient(160deg, #4a6b52 0%, #2e4535 50%, #1e2e24 100%);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .aerial-placeholder::after {
        content: 'Property imagery preview';
        color: rgba(255,255,255,0.45);
        font-size: 12px;
        font-weight: 300;
        letter-spacing: 0.05em;
      }

      .cover-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 28px 36px 24px;
        background: linear-gradient(to top, rgba(30,46,36,0.92) 0%, rgba(30,46,36,0.4) 70%, transparent 100%);
      }

      .cover-label {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: rgba(248,246,228,0.6);
        margin-bottom: 6px;
      }

      .cover-address {
        font-size: 26px;
        font-weight: 600;
        color: var(--sand);
        line-height: 1.2;
        margin-bottom: 12px;
      }

      .cover-meta {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
      }

      .cover-meta-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }

      .cover-meta-label {
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(248,246,228,0.5);
      }

      .cover-meta-value {
        font-size: 13px;
        font-weight: 500;
        color: rgba(248,246,228,0.9);
      }

      .header-bar {
        background: var(--bluegum);
        padding: 14px 36px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo-block {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .logo-mark {
        width: 28px;
        height: 28px;
        background: var(--sand);
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
        color: var(--bluegum);
      }

      .logo-text {
        font-size: 16px;
        font-weight: 600;
        color: var(--sand);
        letter-spacing: -0.01em;
      }

      .logo-text span {
        font-weight: 300;
        color: rgba(248,246,228,0.7);
      }

      .report-meta {
        text-align: right;
      }

      .report-type {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(248,246,228,0.55);
      }

      .report-id {
        font-size: 12px;
        font-weight: 400;
        color: rgba(248,246,228,0.75);
        margin-top: 2px;
      }

      .prepared-for {
        background: var(--sand-mid);
        border-bottom: 1px solid var(--border);
        padding: 14px 36px;
        display: flex;
        gap: 40px;
        align-items: center;
        flex-wrap: wrap;
      }

      .pf-item {
        display: flex;
        gap: 8px;
        align-items: baseline;
      }

      .pf-label {
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-light);
      }

      .pf-value {
        font-size: 13px;
        font-weight: 500;
        color: var(--text);
      }

      .body {
        padding: 0 36px 48px;
      }

      .section-header {
        padding: 28px 0 14px;
        border-bottom: 2px solid var(--eucalypt);
        margin-bottom: 20px;
        display: flex;
        align-items: baseline;
        gap: 12px;
      }

      .section-title {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--eucalypt);
      }

      .section-rule {
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .exec-intro {
        font-size: 15px;
        font-weight: 400;
        color: var(--text);
        line-height: 1.65;
        margin-bottom: 20px;
        padding: 20px 24px;
        background: var(--white);
        border-left: 3px solid var(--eucalypt);
        border-radius: 0 6px 6px 0;
      }

      .exec-intro strong {
        font-weight: 600;
        color: var(--bluegum);
      }

      .subsection-kicker {
        font-size: 10px;
        font-weight: 600;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--eucalypt);
        margin-bottom: 8px;
      }

      .verdict-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        background: var(--white);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(73,79,74,0.08);
      }

      .verdict-table thead tr {
        background: var(--bluegum);
      }

      .verdict-table thead th {
        padding: 11px 16px;
        text-align: left;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: rgba(248,246,228,0.7);
      }

      .verdict-table tbody tr {
        border-bottom: 1px solid var(--sand-dark);
      }

      .verdict-table tbody tr:last-child {
        border-bottom: none;
      }

      .verdict-table td {
        padding: 14px 16px;
        vertical-align: top;
      }

      .verdict-option {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 3px;
      }

      .verdict-sub {
        font-size: 11px;
        color: var(--text-light);
        font-weight: 300;
      }

      .verdict-desc {
        font-size: 12px;
        color: var(--text);
        line-height: 1.55;
      }

      .verdict-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 11px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
      }

      .badge-viable {
        background: var(--green-ok-bg);
        color: var(--green-ok);
      }

      .badge-constrained {
        background: var(--amber-bg);
        color: var(--amber);
      }

      .badge-unlikely {
        background: var(--red-bg);
        color: var(--red);
      }

      .badge-unavailable {
        background: var(--grey-bg);
        color: var(--grey);
      }

      .overall-view {
        background: var(--bluegum);
        color: var(--sand);
        padding: 20px 24px;
        border-radius: 8px;
        margin-bottom: 8px;
      }

      .overall-view-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(248,246,228,0.55);
        margin-bottom: 8px;
      }

      .overall-view p {
        font-size: 14px;
        font-weight: 400;
        line-height: 1.65;
        color: rgba(248,246,228,0.9);
      }

      .supporting-note {
        font-size: 11px;
        color: var(--text-light);
        font-style: italic;
        margin-bottom: 20px;
        line-height: 1.6;
      }

      .constraint-card {
        background: var(--white);
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 14px;
        box-shadow: 0 1px 4px rgba(73,79,74,0.07);
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .card-header {
        padding: 13px 20px;
        background: var(--sand-mid);
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
      }

      .card-title {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--bluegum);
      }

      .card-readings {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .card-reading {
        display: flex;
        gap: 5px;
        align-items: baseline;
      }

      .card-reading-label {
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--text-light);
      }

      .card-reading-value {
        font-size: 12px;
        font-weight: 600;
        color: var(--bluegum);
      }

      .card-body {
        padding: 18px 20px;
      }

      .card-insight {
        font-size: 13px;
        font-weight: 500;
        color: var(--text);
        margin-bottom: 8px;
        line-height: 1.55;
      }

      .card-body p {
        font-size: 12px;
        color: var(--text-light);
        line-height: 1.65;
        margin-bottom: 8px;
      }

      .card-body p:last-child {
        margin-bottom: 0;
      }

      .card-body ul {
        margin: 10px 0 0 18px;
      }

      .card-body li {
        font-size: 12px;
        color: var(--text-light);
        line-height: 1.6;
        margin-bottom: 4px;
      }

      .map-image-wrap {
        margin-top: 0;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--border);
      }

      .map-image {
        width: 100%;
        height: auto;
        max-height: 360px;
        object-fit: cover;
        display: block;
      }

      .map-placeholder {
        margin-top: 0;
        border-radius: 6px;
        overflow: hidden;
        border: 1px solid var(--border);
      }

      .map-placeholder-inner {
        height: 220px;
        background:
          repeating-linear-gradient(0deg, rgba(109,122,112,0.08) 0px, rgba(109,122,112,0.08) 1px, transparent 1px, transparent 24px),
          repeating-linear-gradient(90deg, rgba(109,122,112,0.08) 0px, rgba(109,122,112,0.08) 1px, transparent 1px, transparent 24px),
          linear-gradient(135deg, #e8ede9 0%, #dde4de 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
      }

      .map-placeholder-icon {
        font-size: 24px;
        opacity: 0.4;
      }

      .map-placeholder-text {
        font-size: 11px;
        font-weight: 500;
        color: var(--eucalypt);
        letter-spacing: 0.06em;
      }

      .map-placeholder-sub {
        font-size: 10px;
        color: var(--text-light);
      }

      .map-caption {
        font-size: 10px;
        color: var(--text-light);
        font-style: italic;
        padding-top: 8px;
      }

      .implication-row {
        display: flex;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--sand-dark);
        align-items: flex-start;
      }

      .implication-row:last-child {
        border-bottom: none;
      }

      .implication-icon {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        flex-shrink: 0;
        margin-top: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 700;
      }

      .icon-yes {
        background: var(--green-ok-bg);
        color: var(--green-ok);
      }

      .icon-no {
        background: var(--red-bg);
        color: var(--red);
      }

      .icon-maybe {
        background: var(--amber-bg);
        color: var(--amber);
      }

      .implication-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 2px;
      }

      .implication-desc {
        font-size: 12px;
        color: var(--text-light);
        line-height: 1.55;
      }

      .intent-box {
        background: var(--sand-mid);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 18px 22px;
        margin-bottom: 20px;
      }

      .intent-label {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--eucalypt);
        margin-bottom: 6px;
      }

      .intent-text {
        font-size: 14px;
        font-weight: 500;
        color: var(--text);
        line-height: 1.55;
      }

      .pathway-card {
        background: var(--white);
        border-radius: 8px;
        padding: 22px 24px;
        margin-bottom: 14px;
        box-shadow: 0 1px 4px rgba(73,79,74,0.08);
        border-left: 3px solid var(--eucalypt);
      }

      .pathway-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--bluegum);
        margin-bottom: 8px;
      }

      .pathway-desc {
        font-size: 13px;
        color: var(--text);
        line-height: 1.65;
        margin-bottom: 14px;
      }

      .pathway-what-includes {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--eucalypt);
        margin-bottom: 8px;
      }

      .pathway-items {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .pathway-items li {
        font-size: 12px;
        color: var(--text-light);
        padding-left: 14px;
        position: relative;
        line-height: 1.5;
      }

      .pathway-items li::before {
        content: '—';
        position: absolute;
        left: 0;
        color: var(--eucalypt);
        font-size: 11px;
      }

      .cta-button {
        display: inline-block;
        margin-top: 16px;
        background: var(--bluegum);
        color: var(--sand);
        padding: 11px 22px;
        border-radius: 5px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.05em;
        text-decoration: none;
      }

      .or-sell {
        margin-top: 10px;
        padding: 16px 20px;
        background: var(--sand-mid);
        border-radius: 6px;
        border: 1px solid var(--border);
        font-size: 12px;
        color: var(--text-light);
        line-height: 1.6;
      }

      .or-sell strong {
        color: var(--text);
        font-weight: 600;
      }

      .contact-footer {
        background: var(--bluegum);
        padding: 28px 36px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-top: 36px;
      }

      .contact-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--sand);
        margin-bottom: 2px;
      }

      .contact-role {
        font-size: 11px;
        color: rgba(248,246,228,0.6);
        margin-bottom: 10px;
      }

      .contact-details {
        display: flex;
        flex-direction: column;
        gap: 3px;
      }

      .contact-detail {
        font-size: 12px;
        color: rgba(248,246,228,0.8);
        text-decoration: none;
      }

      .contact-right {
        text-align: right;
      }

      .contact-logo {
        font-size: 18px;
        font-weight: 600;
        color: var(--sand);
        margin-bottom: 4px;
      }

      .contact-logo span {
        font-weight: 300;
        opacity: 0.7;
      }

      .contact-url {
        font-size: 11px;
        color: rgba(248,246,228,0.55);
      }

      .disclaimer {
        padding: 24px 36px;
        background: var(--sand-dark);
        border-top: 1px solid var(--border);
      }

      .disclaimer-title {
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--text-light);
        margin-bottom: 8px;
      }

      .disclaimer p {
        font-size: 10.5px;
        color: var(--text-light);
        line-height: 1.65;
        margin-bottom: 6px;
      }

      .disclaimer p:last-child {
        margin-bottom: 0;
      }

      @media print {
        body {
          background: white;
        }

        .page {
          max-width: 100%;
        }
      }

      @page {
        size: A4;
        margin: 14mm 12mm 16mm;
      }
  body
    - const planningContext = report.siteSections.find((section) => section.key === 'planning-context');
    - const assessmentSections = report.siteSections.filter((section) => section.key !== 'planning-context');
    - const badgeClassMap = { possible: 'badge-viable', review: 'badge-constrained', not_available: 'badge-unavailable' };
    - const implicationClassMap = { possible: 'icon-yes', review: 'icon-maybe', not_available: 'icon-no' };
    - const implicationSymbolMap = { possible: '✓', review: '⚠', not_available: '✗' };
    .page
      .cover
        if report.coverImage
          img.cover-photo(src=report.coverImage.url alt=report.coverImage.label || report.cover.address)
        else
          .cover-photo-placeholder
            .aerial-placeholder
        .cover-overlay
          .cover-label Site assessment report
          .cover-address= report.cover.address
          .cover-meta
            .cover-meta-item
              span.cover-meta-label Zone
              span.cover-meta-value= report.property.zone
            if report.property.blockSize && report.property.blockSize !== '—'
              .cover-meta-item
                span.cover-meta-label Block size
                span.cover-meta-value= report.property.blockSize
            if report.property.frontage && report.property.frontage !== '—'
              .cover-meta-item
                span.cover-meta-label Frontage
                span.cover-meta-value= report.property.frontage
            .cover-meta-item
              span.cover-meta-label Date
              span.cover-meta-value= report.cover.date
            if report.cover.reportId
              .cover-meta-item
                span.cover-meta-label Report
                span.cover-meta-value= report.cover.reportId
            if report.cover.blockSection
              .cover-meta-item
                span.cover-meta-label Block / section
                span.cover-meta-value= report.cover.blockSection

      .header-bar
        .logo-block
          .logo-mark B
          .logo-text
            strong Block
            span Planner
        .report-meta
          .report-type Property Assessment
          .report-id
            | Prepared for #{report.cover.preparedFor}
            if report.cover.reportId
              |  · Report #{report.cover.reportId}

      .prepared-for
        .pf-item
          span.pf-label Prepared for
          span.pf-value= report.cover.preparedFor
        .pf-item
          span.pf-label Intention
          span.pf-value= report.property.intention
        .pf-item
          span.pf-label Issued
          span.pf-value= report.cover.date

      .body
        .section-header
          span.section-title= report.executiveSummary.title
          .section-rule

        .exec-intro
          | Your block at #{report.cover.address} is a 
          strong #{report.property.blockSize} #{report.property.zone} block
          | . #{report.executiveSummary.intro}

        .subsection-kicker= report.executiveSummary.rulesTitle
        table.verdict-table(style='margin-bottom: 6px;')
          thead
            tr
              th(style='width:38%') Option
              th(style='width:42%') Current rules
              th(style='width:20%') Size threshold
          tbody
            each item in report.executiveSummary.rulesRows
              tr
                td
                  .verdict-option= item.title
                  if item.subtitle
                    .verdict-sub= item.subtitle
                td.verdict-desc= item.text
                td
                  span.verdict-badge(class=badgeClassMap[item.statusTone])= item.statusLabel
        p.supporting-note= report.executiveSummary.rulesNote

        .subsection-kicker= report.executiveSummary.findingsTitle
        table.verdict-table
          thead
            tr
              th(style='width:30%') Option
              th(style='width:50%') What we found on this block
              th(style='width:20%') Our read
          tbody
            each item in report.executiveSummary.findingsRows
              tr
                td
                  .verdict-option= item.title
                  if item.subtitle
                    .verdict-sub= item.subtitle
                td.verdict-desc= item.text
                td
                  span.verdict-badge(class=badgeClassMap[item.statusTone])= item.statusLabel

        if report.executiveSummary.summary
          .overall-view(style='margin-top: 14px;')
            .overall-view-label Overall view
            p= report.executiveSummary.summary

        if planningContext
          .section-header(style='margin-top: 32px;')
            span.section-title Planning context
            .section-rule
          .constraint-card
            .card-header
              .card-title= planningContext.title
              .card-readings
                .card-reading
                  span.card-reading-label Zone
                  span.card-reading-value= report.property.zone
                if report.cover.blockSection
                  .card-reading
                    span.card-reading-label Block / section
                    span.card-reading-value= report.cover.blockSection
            .card-body
              - const planningInsight = planningContext.paragraphs[0] || '';
              - const planningBody = planningContext.paragraphs.slice(1);
              if planningInsight
                .card-insight= planningInsight
              each para in planningBody
                p= para

        .section-header(style='margin-top: 32px;')
          span.section-title Site assessment
          .section-rule

        p(style='font-size:13px; color: var(--text-light); margin-bottom: 18px; line-height:1.65;')
          | This section assesses the physical conditions on your block. These are the practical constraints that determine whether the permitted options are actually achievable.

        .constraint-card(style='margin-bottom: 22px;')
          .card-header
            .card-title Site map — block boundary, easements, sewer and trees
          .card-body
            if report.siteMap
              .map-image-wrap
                img.map-image(src=report.siteMap.url alt=report.siteMap.label)
            else
              .map-placeholder
                .map-placeholder-inner
                  .map-placeholder-icon 🗺
                  .map-placeholder-text Site map unavailable
                  .map-placeholder-sub No staff-supplied map image or fallback imagery was available for this report
            .map-caption
              | #{report.siteMap ? report.siteMap.note : 'No site map image was provided.'} All positions are approximate and should be confirmed through formal due diligence before design or construction decisions are made.

        each section in assessmentSections
          .constraint-card
            .card-header
              .card-title= section.title
              if section.metaItems && section.metaItems.length
                .card-readings
                  each item in section.metaItems
                    .card-reading
                      span.card-reading-label= item.label
                      span.card-reading-value= item.value
            .card-body
              - const preferredInsightIndex = section.key === 'site-coverage' || section.key === 'driveway' ? 1 : 0;
              - const actualInsightIndex = section.paragraphs && section.paragraphs[preferredInsightIndex] ? preferredInsightIndex : 0;
              - const sectionInsight = section.paragraphs && section.paragraphs.length ? section.paragraphs[actualInsightIndex] : '';
              - const sectionBody = section.paragraphs ? section.paragraphs.filter((_, index) => index !== actualInsightIndex) : [];
              if sectionInsight
                .card-insight= sectionInsight
              each para in sectionBody
                p= para
              if section.bullets && section.bullets.length
                ul
                  each item in section.bullets
                    li= item

        .section-header(style='margin-top: 32px;')
          span.section-title What this means for your block
          .section-rule

        .constraint-card
          .card-body
            each item in report.executiveSummary.findingsRows
              .implication-row
                .implication-icon(class=implicationClassMap[item.statusTone])= implicationSymbolMap[item.statusTone]
                .implication-content
                  .implication-title
                    = item.title
                    if item.subtitle
                      |  — #{item.subtitle}
                  .implication-desc= item.text

        .section-header(style='margin-top: 32px;')
          span.section-title Your next step
          .section-rule

        .intent-box
          .intent-label Your intention when ordering this report
          .intent-text= report.nextStep.intentionLabel

        if report.nextStep.paragraphs && report.nextStep.paragraphs.length
          p(style='font-size: 13px; color: var(--text-light); line-height: 1.65; margin-bottom: 20px;')
            = report.nextStep.paragraphs[0]

        .pathway-card
          .pathway-title= report.nextStep.title
          if report.nextStep.paragraphs && report.nextStep.paragraphs[1]
            .pathway-desc= report.nextStep.paragraphs[1]
          .pathway-what-includes Key considerations
          ul.pathway-items
            each item in report.nextStep.checklist
              li= item
          a.cta-button(href=`mailto:${report.contact.email}`)= report.nextStep.cta

        .or-sell
          strong Additional context
          |  #{report.nextStep.closing}

      .contact-footer
        .contact-left
          .contact-name= report.contact.name
          .contact-role= `BlockPlanner · ${report.contact.role}`
          .contact-details
            a.contact-detail(href=`mailto:${report.contact.email}`)= report.contact.email
            if report.contact.phone
              span.contact-detail= report.contact.phone
            a.contact-detail(href=report.contact.websiteUrl)= report.contact.websiteLabel
        .contact-right
          .contact-logo
            strong Block
            span Planner
          .contact-url= report.contact.websiteLabel

      .disclaimer
        .disclaimer-title Important disclaimer
        each para in report.disclaimer.paragraphs
          p= para
