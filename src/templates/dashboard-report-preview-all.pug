doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title Dashboard Report Preview Bundle
    style.
      :root {
        --bg: #f2efe4;
        --card: #ffffff;
        --ink: #24312a;
        --muted: #5d655f;
        --line: #d9d4c2;
        --accent: #4f6559;
        --accent-soft: #e7eee8;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: 'Segoe UI', Arial, sans-serif;
        background: var(--bg);
        color: var(--ink);
      }

      .shell {
        max-width: 1280px;
        margin: 0 auto;
        padding: 28px 24px 40px;
      }

      .hero {
        background: var(--card);
        border: 1px solid var(--line);
        padding: 24px 26px;
        margin-bottom: 20px;
      }

      .hero h1 {
        margin: 0 0 10px;
        font-size: 28px;
      }

      .hero p {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .index {
        margin-top: 16px;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }

      .index a {
        text-decoration: none;
        color: var(--accent);
        background: var(--accent-soft);
        padding: 8px 10px;
        border-radius: 999px;
        font-size: 13px;
      }

      .scenario {
        background: var(--card);
        border: 1px solid var(--line);
        margin-bottom: 22px;
        overflow: hidden;
      }

      .scenario-header {
        padding: 20px 24px 14px;
        border-bottom: 1px solid var(--line);
      }

      .scenario-title {
        margin: 0 0 8px;
        font-size: 21px;
      }

      .scenario-description {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .scenario-meta {
        padding: 14px 24px 18px;
        border-bottom: 1px solid var(--line);
        background: #fbfaf6;
      }

      .scenario-meta h2 {
        margin: 0 0 10px;
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .scenario-meta ul {
        margin: 0;
        padding-left: 18px;
        color: var(--muted);
      }

      .scenario-meta li + li {
        margin-top: 4px;
      }

      .frame-wrap {
        padding: 18px;
        background: #ebe5d4;
      }

      .preview-frame {
        width: 100%;
        border: 1px solid rgba(0, 0, 0, 0.12);
        background: #fff;
        display: block;
      }
  body
    .shell
      .hero
        h1 Dashboard Report Preview Bundle
        p
          | This page renders multiple sample reports so the hard-coded wording branches can be proofread in one place. Each scenario below is generated by the live report service and template.
        .index
          each scenario in scenarios
            a(href=`#${scenario.key}`)= scenario.title

      each scenario in scenarios
        section.scenario(id=scenario.key)
          .scenario-header
            h2.scenario-title= scenario.title
            p.scenario-description= scenario.description
          .scenario-meta
            h2 Copy branches covered
            ul
              each item in scenario.covers
                li= item
          .frame-wrap
            iframe.preview-frame(
              title=scenario.title
              srcdoc=scenario.html
              loading='lazy'
              onload='resizePreviewFrame(this)'
            )
    script.
      function resizePreviewFrame(frame) {
        try {
          var doc = frame.contentDocument || frame.contentWindow.document;
          if (!doc) return;
          var bodyHeight = doc.body ? doc.body.scrollHeight : 0;
          var htmlHeight = doc.documentElement ? doc.documentElement.scrollHeight : 0;
          frame.style.height = Math.max(bodyHeight, htmlHeight, 1400) + 24 + 'px';
        } catch (error) {
          frame.style.height = '2400px';
        }
      }

      window.addEventListener('load', function () {
        Array.prototype.forEach.call(
          document.querySelectorAll('.preview-frame'),
          function (frame) {
            setTimeout(function () { resizePreviewFrame(frame); }, 50);
            setTimeout(function () { resizePreviewFrame(frame); }, 500);
            setTimeout(function () { resizePreviewFrame(frame); }, 1500);
          }
        );
      });
