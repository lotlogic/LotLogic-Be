generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Jurisdiction {
  NSW
  ACT
}

enum RuleSetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BuilderEstateApprovalStatus {
  APPROVED
  REVOKED
}

enum DesignOnLotStatus {
  PASS
  FAIL
  MANUAL_REVIEW
}

model estate {
  id                     BigInt                  @id @default(autoincrement())
  name                   String
  jurisdiction           Jurisdiction            @default(ACT)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  address                String?
  email                  String?
  logoUrl                String?
  phone                  String?
  themeColor             String?
  lots                   lot[]
  userEstates            userEstate[]
  brandSetting           brandSetting?
  builderEstateApprovals builderEstateApproval[]
  estateRuleSets         estateRuleSet[]
  lotConstraints         estateLotConstraint[]
}

model user {
  id             BigInt        @id @default(autoincrement())
  externalAuthId String        @unique
  email          String?
  displayName    String?
  role           UserRole      @default(USER)
  status         UserStatus    @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  estates        userEstate[]
  builderUsers   builderUser[]
}

model userEstate {
  userId    BigInt
  estateId  BigInt
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  estate    estate   @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@id([userId, estateId])
  @@index([estateId])
}

model builderUser {
  userId    BigInt
  builderId BigInt
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  builder   builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)

  @@id([userId, builderId])
  @@index([builderId])
}

model lot {
  id                   BigInt                   @id @default(autoincrement())
  blockKey             String                   @unique
  blockNumber          Int?
  sectionNumber        Int?
  areaSqm              Float
  frontageM            Float?
  lotType              String?
  roadFacing           String?
  precinct             String?
  zoning               String
  address              String?
  district             String?
  division             String?
  lifecycleStage       String?
  ruleOverrides        Json?
  geojson              Json?
  geometry             Unsupported("geometry")?
  estateId             BigInt?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  overlays             String[]
  designOnLots         designOnLot[]
  enquiries            enquiry[]
  estate               estate?                  @relation(fields: [estateId], references: [id])
  lotZoningRules       lotZoningRule[]
  estateLotConstraints estateLotConstraint[]
  frontageCoordinate   Unsupported("geometry")?

  @@index([geometry], map: "geometry_index")
}

model zoningRule {
  id                    BigInt          @id @default(autoincrement())
  code                  String          @unique
  name                  String
  type                  String
  isOverlay             Boolean         @default(false)
  maxBuildingHeight_m   Float?
  maxStoreys            Int?
  minLotArea_sqm        Float?
  minLotWidth_m         Float?
  minLotDepth_m         Float?
  minFrontageStandard_m Float?
  minFrontageCorner_m   Float?
  minFSR                Float?
  maxFSR                Float?
  minFrontSetback_m     Float?
  minRearSetback_m      Float?
  minSideSetback_m      Float?
  appliesToZones        String[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  lotZoningRules        lotZoningRule[]
}

model lotZoningRule {
  lotId        BigInt
  zoningRuleId BigInt
  isOverlay    Boolean    @default(false)
  lot          lot        @relation(fields: [lotId], references: [id], onDelete: Cascade)
  zoningRule   zoningRule @relation(fields: [zoningRuleId], references: [id], onDelete: Cascade)

  @@id([lotId, zoningRuleId])
}

model floorPlan {
  id                         BigInt        @id @default(autoincrement())
  name                       String
  floorplanUrl               String?
  bedrooms                   Int
  bathrooms                  Int
  garages                    Int
  areaSqm                    Float
  width                      Float
  depth                      Float
  storeys                    Int?
  buildingHeight_m           Float?
  roofPitch_deg              Float?
  architecturalStyle         String?
  hasFrontFacingServiceAreas Boolean?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  rumpus                     Boolean
  alfresco                   Boolean
  pergola                    Boolean
  builderId                  BigInt
  builder                    builder       @relation(fields: [builderId], references: [id])
  designOnLots               designOnLot[]
  enquiries                  enquiry[]
  facades                    facade[]

  @@index([builderId])
}

model facade {
  id          BigInt    @id @default(autoincrement())
  label       String
  imageUrl    String
  floorPlanId BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  enquiries   enquiry[]
  floorPlan   floorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
}

model designOnLot {
  id                  BigInt            @id @default(autoincrement())
  lotId               BigInt
  floorPlanId         BigInt
  isCompatible        Boolean
  status              DesignOnLotStatus @default(FAIL)
  failReasons         String[]          @default([])
  manualReviewReasons String[]          @default([])
  matchedFilters      Json?
  assessedAt          DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  stateRuleSetId      BigInt?
  estateRuleSetId     BigInt?
  floorPlan           floorPlan         @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  lot                 lot               @relation(fields: [lotId], references: [id], onDelete: Cascade)
  stateRuleSet        stateRuleSet?     @relation(fields: [stateRuleSetId], references: [id], onDelete: SetNull)
  estateRuleSet       estateRuleSet?    @relation(fields: [estateRuleSetId], references: [id], onDelete: SetNull)

  @@unique([lotId, floorPlanId])
  @@index([lotId, isCompatible])
  @@index([status])
}

model stateRuleSet {
  id            BigInt        @id @default(autoincrement())
  jurisdiction  Jurisdiction
  name          String
  version       Int           @default(1)
  status        RuleSetStatus @default(DRAFT)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  rules         Json
  sourceUrl     String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  designOnLots  designOnLot[]

  @@unique([jurisdiction, version])
  @@index([jurisdiction, status])
}

model estateRuleSet {
  id             BigInt                @id @default(autoincrement())
  estateId       BigInt
  name           String
  version        Int                   @default(1)
  status         RuleSetStatus         @default(DRAFT)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  rules          Json
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  estate         estate                @relation(fields: [estateId], references: [id], onDelete: Cascade)
  lotConstraints estateLotConstraint[]
  designOnLots   designOnLot[]

  @@unique([estateId, version])
  @@index([estateId, status])
}

model estateLotConstraint {
  id              BigInt         @id @default(autoincrement())
  estateId        BigInt
  lotId           BigInt
  estateRuleSetId BigInt?
  name            String
  isActive        Boolean        @default(true)
  rules           Json
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  estate          estate         @relation(fields: [estateId], references: [id], onDelete: Cascade)
  lot             lot            @relation(fields: [lotId], references: [id], onDelete: Cascade)
  estateRuleSet   estateRuleSet? @relation(fields: [estateRuleSetId], references: [id], onDelete: SetNull)

  @@index([estateId, lotId, isActive])
}

model builderEstateApproval {
  id            BigInt                      @id @default(autoincrement())
  builderId     BigInt
  estateId      BigInt
  status        BuilderEstateApprovalStatus @default(APPROVED)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  notes         String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt
  builder       builder                     @relation(fields: [builderId], references: [id], onDelete: Cascade)
  estate        estate                      @relation(fields: [estateId], references: [id], onDelete: Cascade)

  @@unique([builderId, estateId])
  @@index([estateId, status])
}

model builder {
  id              BigInt                  @id @default(autoincrement())
  name            String
  email           String
  phone           String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  enquiryBuilders enquiryBuilder[]
  builderUsers    builderUser[]
  floorPlans      floorPlan[]
  estateApprovals builderEstateApproval[]
}

model enquiry {
  id              BigInt           @id @default(autoincrement())
  name            String
  email           String
  phone           String
  comments        String?
  lotId           BigInt?
  floorPlanId     BigInt?
  facadeId        BigInt?
  createdAt       DateTime         @default(now())
  facade          facade?          @relation(fields: [facadeId], references: [id])
  floorPlan       floorPlan?       @relation(fields: [floorPlanId], references: [id])
  lot             lot?             @relation(fields: [lotId], references: [id])
  enquiryBuilders enquiryBuilder[]
}

model enquiryBuilder {
  id        BigInt   @id @default(autoincrement())
  enquiryId BigInt
  builderId BigInt
  createdAt DateTime @default(now())
  builder   builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  enquiry   enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@unique([enquiryId, builderId])
}

model brandSetting {
  id       String  @id @default(cuid())
  guid     String  @unique @default(uuid()) @db.Uuid
  estateId BigInt? @unique

  name    String
  title   String
  logoUrl String

  primaryColor        String?
  secondaryColor      String?
  bgPrimaryColor      String?
  bgSecondaryColor    String?
  textPrimaryColor    String?
  textSecondaryColor  String?
  fontFamilyPrimary   String?
  fontFamilySecondary String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  estate estate? @relation(fields: [estateId], references: [id], onDelete: Cascade)
}

model geoData {
  // Single logical row — always id = "default"
  id          Int      @id @default(autoincrement())
  name        String?
  color       String?
  coordinates String
  geoType     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model actLandUseZone {
  id         Int                     @id @default(autoincrement())
  objectId   Int                     @unique
  zoneCode   String
  properties Json
  geometry   Unsupported("geometry")
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
}

model actBlock {
  id             Int                     @id @default(autoincrement())
  objectId       Int                     @unique
  blockKey       BigInt
  blockNumber    Int
  sectionNumber  Int
  derivedAreaSqm BigInt?
  properties     Json
  geometry       Unsupported("geometry")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([blockKey])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
