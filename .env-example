# Core runtime (container)
DATABASE_URL="postgresql://postgres:lotlogic123@localhost:5432/lotlogic"
# Entrypoint behavior (defaults shown)
AUTO_MIGRATE=true
AUTO_SEED=false
AUTO_SEED_SKIP_IF_DATA=true
AUTO_IMPORT_ACT_DATA=false

# Microsoft Entra ID -> Microsoft Graph invitations (admin invite flow)
# One of ENTRA_TENANT_ID or AZURE_TENANT_ID is required.
ENTRA_TENANT_ID=""
AZURE_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
# Used if redirectUrl is not provided in POST /api/admin/invitations
ENTRA_INVITE_REDIRECT_URL="http://localhost:5173/"
# Optional (defaults to https://graph.microsoft.com/.default)
ENTRA_GRAPH_SCOPE="https://graph.microsoft.com/.default"

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Sender identities are fixed in backend code:
# - BlockPlanner flows send as: BlockPlanner <noreply@mail.blockplanner.com.au>
# - LotCheck flows send as: LotCheck <noreply@mail.lotcheck.com.au>
# Optional: dedicated SMTP override for LotCheck sender profile
LOTCHECK_SMTP_HOST=
LOTCHECK_SMTP_PORT=587
LOTCHECK_SMTP_USER=
LOTCHECK_SMTP_PASS=
# Get-in-touch recipient (used by POST /api/enquiry/get-in-touch)
GET_IN_TOUCH_RECIPIENT_EMAIL=mitch@blockplanner.com.au

# Google Geocoding (Address -> Lat/Lng) for /api/geo/act-zone
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional: bias geocoding results
GOOGLE_GEOCODING_REGION=au
GOOGLE_GEOCODING_COMPONENTS=country:AU|administrative_area:ACT

# LotCheck rules CSV (optional override; defaults to data/ file if unset)
LOT_CHECK_RULES_CSV_PATH="data/2. LotCheck - Reference Data - Rules v3.csv"

# monday.com paid reports workflow
MONDAY_API_TOKEN=
# Optional: defaults to https://api.monday.com/v2
MONDAY_API_BASE_URL=https://api.monday.com/v2
# Optional: defaults to 2026-01
MONDAY_API_VERSION=2026-01
# Optional: defaults shown from the current BlockPlanner board sample
MONDAY_PAID_REPORTS_BOARD_ID=5028030238
MONDAY_PAID_REPORTS_GROUP_ID=group_mm2qpyaz
MONDAY_TREE_LOCATION_COLUMN_ID=dropdown_mm35539t
MONDAY_REGISTERED_TREES_COLUMN_ID=dropdown_mm35eqsb
# Optional: defaults shown from the current BlockPlanner leads board sample
MONDAY_LEADS_BOARD_ID=5028030146
MONDAY_LEADS_GROUP_ID=topics
MONDAY_LEADS_EMAIL_COLUMN_ID=lead_email
MONDAY_LEADS_SOURCE_COLUMN_ID=color_mkyb8krc
# Optional: require a shared secret for monday trigger/delivery webhook calls
MONDAY_WEBHOOK_SECRET=

# Dashboard report generation (monday trigger -> backend -> HTML->PDF -> Azure Blob -> update item)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
# Optional: folder prefix inside the container
AZURE_STORAGE_FOLDER=dashboard-reports
# Admin uploads (SAS -> direct-to-blob)
# Optional: folder prefix inside the container
AZURE_STORAGE_UPLOADS_FOLDER=uploads
# Optional: signed URL lifetime (minutes)
AZURE_UPLOAD_SAS_MINUTES=15
# Optional: max upload size in bytes (defaults to 100MB)
AZURE_UPLOAD_MAX_BYTES=104857600
# Optional: path to Chrome/Chromium executable for puppeteer-core
CHROME_EXECUTABLE_PATH=
# Optional: alternate puppeteer executable path
PUPPETEER_EXECUTABLE_PATH=

# Dashboard report delivery (monday "Delivery status" -> backend -> email PDF -> update item)
# Optional: override recipient for testing (comma-separated list supported)
MONDAY_DELIVERY_EMAIL_OVERRIDE=
# Optional: PDF download timeout (ms)
DASHBOARD_DELIVERY_PDF_TIMEOUT_MS=30000
# Optional: image fetch timeout (ms) for remote imagery used in paid PDFs
DASHBOARD_IMAGE_FETCH_TIMEOUT_MS=20000

# Mixpanel
# Used by admin performance views and audit log export queries.
# The service account credentials are required to read paged event data back from Mixpanel.
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_SERVICE_ACCOUNT_USERNAME=
MIXPANEL_SERVICE_ACCOUNT_SECRET=

# Stripe
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CHECKOUT_PRICE_ID="price_your_checkout_price_id"
