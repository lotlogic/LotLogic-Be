# Core runtime (container)
DATABASE_URL="postgresql://postgres:lotlogic123@localhost:5432/lotlogic"
# Entrypoint behavior (defaults shown)
AUTO_MIGRATE=true
AUTO_SEED=false
AUTO_SEED_SKIP_IF_DATA=true
AUTO_IMPORT_ACT_DATA=false

# Microsoft Entra ID -> Microsoft Graph invitations (admin invite flow)
# One of ENTRA_TENANT_ID or AZURE_TENANT_ID is required.
ENTRA_TENANT_ID=""
AZURE_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
# Used if redirectUrl is not provided in POST /api/admin/invitations
ENTRA_INVITE_REDIRECT_URL="http://localhost:5173/"
# Optional (defaults to https://graph.microsoft.com/.default)
ENTRA_GRAPH_SCOPE="https://graph.microsoft.com/.default"

# Mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Google Geocoding (Address -> Lat/Lng) for /api/geo/act-zone
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Optional: bias geocoding results
GOOGLE_GEOCODING_REGION=au
GOOGLE_GEOCODING_COMPONENTS=country:AU|administrative_area:ACT

# LotCheck rules CSV (optional override; defaults to data/ file if unset)
LOT_CHECK_RULES_CSV_PATH="data/LotCheck - Public tool data   - Rules v3.csv"

# Google Sheets (Form POST -> Apps Script webhook -> append row)
GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/AKfycbw8nAfUizIrC8RIPVcMNiXZ3hoDvPu4ruyayIQwjcbU9Xu4KYTqgX_fylgjfZrio8sNdg/exec
# Note: the backend sends this secret as a query param (?secret=...) and also inside the JSON body as `secret`.
GOOGLE_SHEETS_WEB_APP_SECRET=your-webhook-secret
# Optional: require a shared secret for callers of /api/google-sheets/append
GOOGLE_SHEETS_INBOUND_WEBHOOK_SECRET=
# Optional: outbound webhook timeout (ms)
GOOGLE_SHEETS_WEB_APP_TIMEOUT_MS=10000

# Dashboard report generation (Sheets trigger -> backend -> HTML->PDF -> Azure Blob -> update row)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
# Optional: folder prefix inside the container
AZURE_STORAGE_FOLDER=dashboard-reports
# Optional: path to Chrome/Chromium executable for puppeteer-core
CHROME_EXECUTABLE_PATH=
# Optional: alternate puppeteer executable path
PUPPETEER_EXECUTABLE_PATH=

# Dashboard report delivery (Sheets "Delivery status" -> backend -> email PDF -> update row)
# Optional: override recipient for testing (comma-separated list supported)
GOOGLE_SHEETS_DELIVERY_EMAIL_OVERRIDE=
# Optional: PDF download timeout (ms)
DASHBOARD_DELIVERY_PDF_TIMEOUT_MS=30000

# Stripe
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""
